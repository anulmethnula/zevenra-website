# Browser-safe configuration
VITE_API_BASE=/api
# Keep false in Vercel Production. .env.development enables local visual data.
VITE_DEMO_MODE=false
# Public Supabase customer-auth configuration (safe for browser use)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Vercel server-side environment variables (never VITE-prefixed)
# APPS_SCRIPT_URL=
# APPS_SCRIPT_SECRET=
# SESSION_SECRET=
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# ALLOWED_ORIGIN=https://your-domain.lk
# Server runtime copies used to verify customer access tokens
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
