{
  "name": "zevenra-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "dev:demo": "vite --mode demo",
    "qa": "npm run test:api-security && npm run test:order-track && npm run test:discounts && npm run test:delivery-settings && npm run test:delivery-matching && npm run test:shipping-weight && npm run test:delivery-weight-fee && npm run test:checkout-config && npm run test:checkout-amounts && npm run test:receipt-upload && npm run test:rate-sheet && npm run test:images && npm run test:public-cache && npm run test:product-search && npm run typecheck && npm run lint && npm run build",
    "test:api-security": "node --import tsx --test tests/api-security.test.ts",
    "test:order-track": "node --import tsx --test tests/order-track.test.ts",
    "test:discounts": "node --import tsx --test tests/discounts.test.ts",
    "test:delivery-settings": "node --import tsx --test tests/delivery-settings.test.ts",
    "test:delivery-matching": "node --import tsx --test tests/delivery-matching.test.ts",
    "test:shipping-weight": "node --experimental-strip-types --test tests/shipping-weight.test.ts",
    "test:delivery-weight-fee": "node --experimental-strip-types --test tests/delivery-weight-fee.test.ts",
    "test:checkout-config": "node --experimental-strip-types --test tests/checkout-config.test.ts",
    "test:checkout-amounts": "node --experimental-strip-types --test tests/checkout-amounts.test.ts",
    "test:receipt-upload": "node --import tsx --test tests/payment-receipt-upload.test.ts",
    "test:rate-sheet": "node --experimental-strip-types --test tests/courier-rate-sheet.test.ts",
    "test:images": "node --experimental-strip-types --test tests/cloudinary-image.test.ts",
    "test:public-cache": "node --experimental-strip-types --test tests/public-data-cache.test.ts",
    "test:product-search": "node --experimental-strip-types --test tests/product-search.test.ts",
    "dev:full": "node --env-file=.env.local scripts/dev-full.mjs",
    "admin:hash-password": "node scripts/hash-admin-password.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "db:search-smoke": "node --env-file=.env.local --import tsx scripts/search-smoke.ts",
    "db:smoke": "node --env-file=.env.local scripts/query-smoke.mjs",
    "perf:reads": "node scripts/load-test-reads.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "csv-parse": "^7.0.3",
    "framer-motion": "^11.11.17",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.1",
    "read-excel-file": "^5.8.8",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.2",
    "@vercel/node": "^13.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
