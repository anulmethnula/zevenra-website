function migrateDatabase(){const lock=LockService.getScriptLock();lock.waitLock(30000);try{const ss=SpreadsheetApp.getActive();Object.keys(SCHEMA).forEach(name=>{let sh=ss.getSheetByName(name);if(!sh){sh=ss.insertSheet(name);sh.appendRow(SCHEMA[name]);logMigration_('create-sheet','Created '+name);return}if(sh.getLastRow()===0)sh.appendRow(SCHEMA[name]);const existing=sh.getRange(1,1,1,Math.max(1,sh.getLastColumn())).getValues()[0].map(String);SCHEMA[name].forEach(column=>{if(existing.indexOf(column)<0){sh.getRange(1,sh.getLastColumn()+1).setValue(column);existing.push(column);logMigration_('add-column','Added '+name+'.'+column)}});sh.setFrozenRows(1);sh.getRange(1,1,1,sh.getLastColumn()).setFontWeight('bold').setBackground('#171613').setFontColor('#f4efe5')});const versions=read_('SchemaVersion');if(!versions.some(v=>String(v.version)==='2'))append_('SchemaVersion',{version:2,appliedAt:new Date().toISOString(),description:'Dynamic storefront, navigation and homepage schema'});return 'Database is at schema version 2. Existing rows were preserved.'}finally{lock.releaseLock()}}
