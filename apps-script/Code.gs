function updateOrder_(p){const lock=LockService.getScriptLock();lock.waitLock(30000);try{const order=read_('Orders').find(o=>String(o.orderId)===String(p.orderId));if(!order)throw new Error('Order not found');const items=read_('OrderItems').filter(i=>String(i.orderId)===String(p.orderId)),required={};items.forEach(i=>{required[String(i.variantId)]=(required[String(i.variantId)]||0)+Number(i.quantity||0)});const was=bool_(order.stockDeducted),nextStatus=String(p.orderStatus===undefined?order.orderStatus:p.orderStatus),wasCancelled=String(order.orderStatus).toLowerCase()==='cancelled',willCancel=nextStatus.toLowerCase()==='cancelled';if(willCancel&&was){const variants=read_('Variants');Object.keys(required).forEach(variantId=>{const v=variants.find(x=>String(x.id)===variantId);if(v)patch_('Variants','id',variantId,{stock:Number(v.stock||0)+Number(required[variantId])})});p.stockDeducted=false}else if(wasCancelled&&!willCancel&&!was){const variants=read_('Variants');Object.keys(required).forEach(variantId=>{const v=variants.find(x=>String(x.id)===variantId);if(!v||Number(v.stock)<Number(required[variantId]))throw new Error('Insufficient stock to reopen this order.')});Object.keys(required).forEach(variantId=>{const v=variants.find(x=>String(x.id)===variantId);patch_('Variants','id',variantId,{stock:Number(v.stock)-Number(required[variantId])})});p.stockDeducted=true}p.updatedAt=new Date().toISOString();patch_('Orders','orderId',p.orderId,p);audit_('owner','update','order',p.orderId,p);return getOrder_(p)}finally{lock.releaseLock()}}
function saveProduct_(input){const lock=LockService.getScriptLock();lock.waitLock(30000);try{const p=Object.assign({},input),variants=p.variants||[],collections=p.collectionIds||[],media=p.media||[];if(!p.name||!p.slug||Number(p.price)<=0)throw new Error('Product name, slug and price are required.');if(!read_('Categories').some(category=>String(category.id)===String(p.categoryId)))throw new Error('Choose a valid category.');if(p.sizeChartId&&!read_('SizeCharts').some(chart=>String(chart.id)===String(p.sizeChartId)))throw new Error('Choose a valid size chart.');if(read_('Products').some(existing=>String(existing.slug)===String(p.slug)&&String(existing.id)!==String(p.id)))throw new Error('Product slug already exists.');const activeVariants=variants.filter(v=>bool_(v.active));if(!activeVariants.length)throw new Error('Add at least one active size / stock variant.');const seen={};activeVariants.forEach(v=>{const key=String(v.color||'').trim().toLowerCase()+'|'+String(v.size||'').trim().toLowerCase();if(!String(v.color||'').trim()||!String(v.size||'').trim()||Number(v.stock)<0)throw new Error('Every active variant needs colour, size and valid stock.');if(seen[key])throw new Error('Duplicate colour and size variant.');seen[key]=true});delete p.variants;delete p.collectionIds;delete p.media;p.mediaJson=JSON.stringify(media);p.tags=Array.isArray(p.tags)?p.tags.join(','):p.tags;p.updatedAt=new Date().toISOString();if(!p.id){p.id=Utilities.getUuid();p.createdAt=p.updatedAt}upsert_('Products','id',p);const kept={};variants.forEach(v=>{v=Object.assign({},v,{productId:p.id});if(!v.id)v.id=Utilities.getUuid();kept[v.id]=true;upsert_('Variants','id',v)});read_('Variants').filter(v=>v.productId===p.id&&!kept[v.id]).forEach(v=>remove_('Variants','id',v.id));remove_('ProductCollections','productId',p.id);collections.forEach(collectionId=>append_('ProductCollections',{productId:p.id,collectionId}));audit_('owner','save','product',p.id,{name:p.name});return listProducts_().find(x=>x.id===p.id)}finally{lock.releaseLock()}}
function saveCategory_(input){const p=Object.assign({},input),categories=read_('Categories');p.name=String(p.name||'').trim();p.slug=String(p.slug||'').trim().toLowerCase();if(!p.name||!p.slug)throw new Error('Category name and slug are required.');if(categories.some(c=>String(c.slug).toLowerCase()===p.slug&&String(c.id)!==String(p.id)))throw new Error('Category slug already exists.');if(p.parentId){const parent=categories.find(c=>String(c.id)===String(p.parentId));if(!parent||parent.parentId)throw new Error('Choose a valid main category.');if(categories.some(c=>String(c.parentId)===String(p.id)))throw new Error('Move this category children before making it a subcategory.');p.showInNavigation=false}return upsert_('Categories','id',p)}
function saveSizeChart_(input){const p=Object.assign({},input,{columnsJson:JSON.stringify(input.columns||[]),rowsJson:JSON.stringify(input.rows||[])});delete p.columns;delete p.rows;return upsert_('SizeCharts','id',p)}
function deleteCategory_(p){if(read_('Categories').some(c=>String(c.parentId)===String(p.id)))throw new Error('Delete or move the subcategories first.');if(read_('Products').some(product=>String(product.categoryId)===String(p.id)))throw new Error('Move or delete products in this category first.');const category=read_('Categories').find(c=>String(c.id)===String(p.id));remove_('Categories','id',p.id);remove_('Navigation','target',p.id);if(category)remove_('Navigation','target',category.slug);audit_('owner','delete','category',p.id,{});return{deleted:true}}
function deleteCollection_(p){remove_('ProductCollections','collectionId',p.id);remove_('Collections','id',p.id);remove_('Navigation','target',p.id);audit_('owner','delete','collection',p.id,{});return{deleted:true}}
function deleteSizeChart_(p){if(read_('Products').some(product=>String(product.sizeChartId)===String(p.id)))throw new Error('Detach this size chart from products before deleting it.');remove_('SizeCharts','id',p.id);audit_('owner','delete','sizeChart',p.id,{});return{deleted:true}}
function deleteProduct_(p){const hasOrders=read_('OrderItems').some(i=>i.productId===p.id);if(hasOrders)throw new Error('Archive products that are referenced by orders.');remove_('Variants','productId',p.id);remove_('Products','id',p.id);audit_('owner','delete','product',p.id,{});return{deleted:true}}
function dashboard_(){const orders=read_('Orders'),items=read_('OrderItems'),preorders=read_('PreorderRequests'),tz=Session.getScriptTimeZone()||'Asia/Colombo',today=Utilities.formatDate(new Date(),tz,'yyyy-MM-dd'),delivered=orders.filter(o=>String(o.orderStatus).toLowerCase()==='delivered'),eligibleDelivered=delivered.filter(o=>String(o.paymentMethod).toLowerCase()==='cod'||['paid','verified'].indexOf(String(o.paymentStatus).toLowerCase())>=0),eligibleIds={};eligibleDelivered.forEach(o=>eligibleIds[String(o.orderId)]=true);const soldItems=items.filter(i=>eligibleIds[String(i.orderId)]),productRevenue=eligibleDelivered.reduce((n,o)=>n+Number(o.subtotal||0),0),deliveryCollected=eligibleDelivered.reduce((n,o)=>n+Number(o.deliveryFee||0),0),itemsSold=soldItems.reduce((n,i)=>n+Number(i.quantity||0),0),totals={};soldItems.forEach(i=>{const id=String(i.productId),current=totals[id]||{productId:id,name:String(i.productName||'Item'),quantity:0,revenue:0};current.quantity+=Number(i.quantity||0);current.revenue+=Number(i.lineTotal||0);totals[id]=current});const count=s=>orders.filter(o=>String(o.orderStatus).toLowerCase()===s).length,createdDay=o=>{try{return Utilities.formatDate(new Date(String(o.createdAt)),tz,'yyyy-MM-dd')}catch(e){return String(o.createdAt).slice(0,10)}};const preorderNew=preorders.filter(r=>String(r.status)==='new').length,preorderConfirmedItems=preorders.filter(r=>String(r.status)==='confirmed'&&!String(r.batchId||'')).reduce((n,r)=>n+Number(r.quantity||0),0);return{preorderNew,preorderConfirmedItems,preorderTarget:6,ordersToday:orders.filter(o=>createdDay(o)===today).length,pending:count('pending'),confirmed:count('confirmed'),packed:count('packed'),shipped:count('shipped'),delivered:count('delivered'),cancelled:count('cancelled'),revenue:productRevenue,productRevenue,deliveryCollected,itemsSold,topProducts:Object.keys(totals).map(k=>totals[k]).sort((a,b)=>b.quantity-a.quantity||b.revenue-a.revenue).slice(0,8),recent:orders.slice(-10).reverse()}}
function listOrders_(p){let rows=read_('Orders').reverse();if(p.status)rows=rows.filter(o=>o.orderStatus===p.status);if(p.q){const q=String(p.q).toLowerCase();rows=rows.filter(o=>[o.orderId,o.customerName,o.phone,o.email,o.district,o.source].some(v=>String(v).toLowerCase().indexOf(q)>=0))}return rows}
function getOrder_(p){const items=read_('OrderItems').filter(i=>i.orderId===p.orderId),o=read_('Orders').find(x=>x.orderId===p.orderId);return o?Object.assign({},o,{items:items}):null}
function saveSettings_(p){Object.keys(p).forEach(k=>upsert_('SiteSettings','key',{key:k,value:p[k]}));audit_('owner','save','settings','site',Object.keys(p));return settings_()}
function saveDeliveryRates_(p){(p.rates||[]).forEach(r=>{if(!r.id)r.id=Utilities.getUuid();upsert_('DeliveryRates','id',r)});return read_('DeliveryRates')}
function settings_(){return read_('SiteSettings').reduce((o,r)=>(o[r.key]=r.value,o),{})}
function sheet_(n){const s=SpreadsheetApp.getActive().getSheetByName(n);if(!s)throw new Error('Run setup() first: '+n);return s}
function read_(n){const sh=sheet_(n),values=sh.getDataRange().getValues();if(values.length<2)return[];const h=values[0];return values.slice(1).filter(r=>r.some(v=>v!=='' )).map(r=>h.reduce((o,k,i)=>(o[k]=r[i],o),{}))}
function append_(n,obj){const sh=sheet_(n),h=sh.getRange(1,1,1,Math.max(1,sh.getLastColumn())).getValues()[0].map(String);sh.appendRow(h.map(k=>obj[k]===undefined?'':typeof obj[k]==='object'?JSON.stringify(obj[k]):obj[k]))}
function upsert_(n,key,obj){const rows=read_(n),i=rows.findIndex(r=>String(r[key])===String(obj[key]));if(i<0)return append_(n,obj);return patch_(n,key,obj[key],obj)}
function patch_(n,key,value,changes){const sh=sheet_(n),data=sh.getDataRange().getValues(),h=data[0],ki=h.indexOf(key);for(let r=1;r<data.length;r++)if(String(data[r][ki])===String(value)){Object.keys(changes).forEach(k=>{const c=h.indexOf(k);if(c>=0)sh.getRange(r+1,c+1).setValue(typeof changes[k]==='object'?JSON.stringify(changes[k]):changes[k])});return changes}throw new Error(n+' row not found')}
function remove_(n,key,value){const sh=sheet_(n),data=sh.getDataRange().getValues(),ki=data[0].indexOf(key);for(let r=data.length-1;r>=1;r--)if(String(data[r][ki])===String(value))sh.deleteRow(r+1)}
function audit_(admin,action,type,id,details){append_('AuditLog',{timestamp:new Date().toISOString(),admin,action,entityType:type,entityId:id,details:JSON.stringify(details)})}
function safeJson_(v,fallback){try{return JSON.parse(v||'')}catch(e){return fallback}}
function bool_(v){return v===true||String(v).toLowerCase()==='true'}
function out_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON)}
